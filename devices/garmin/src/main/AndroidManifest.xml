    <application>
        <!-- The find-my-phone notification's stop action (GarminFindPhoneRinger). -->
        <receiver
            android:name="tech.mmarca.openwatch.devices.garmin.GarminFindPhoneStopReceiver"
            android:exported="false" />
    </application>
</manifest>
