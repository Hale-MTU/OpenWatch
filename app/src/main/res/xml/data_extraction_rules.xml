<?xml version="1.0" encoding="utf-8"?>
<!--
    allowBackup="false" keeps the app out of cloud backup, but from Android 12 on it
    does not stop a transfer to a new phone. The device state moves with the phone;
    a watch is paired again on the new one anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
