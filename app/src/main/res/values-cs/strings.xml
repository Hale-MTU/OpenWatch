    <string name="settings_watch_notifications_only_allowed">Jen aplikace, které vyberu</string>
    <string name="settings_watch_notifications_only_allowed_body">Zapnuto: posílají jen aplikace zapnuté níže. Vypnuto: posílají všechny kromě vypnutých. Oba seznamy zůstanou zachovány.</string>
    <string name="settings_watch_notifications_hide_sensitive">Skrýt citlivý obsah</string>
    <string name="settings_watch_notifications_hide_sensitive_body">Pokud nastavení oznámení v Androidu skrývá citlivý obsah aplikace na obrazovce uzamčení, hodinky dostanou jen nadpis.</string>
