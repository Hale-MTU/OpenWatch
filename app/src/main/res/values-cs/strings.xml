    <string name="settings_watch_agps_remove">Odebrat</string>
    <string name="settings_watch_agps_imported">Připraveno k předání.</string>
    <string name="settings_watch_agps_not_ephemeris">Tento soubor neobsahuje efemeridy GPS.</string>
    <string name="settings_watch_agps_stale">Tento soubor je příliš starý, než aby pomohl. Efemeridy předpovídají, kde satelity budou, takže cokoli staršího než týden je horší než nic.</string>
    <string name="settings_watch_agps_unreadable">Tento soubor se nepodařilo přečíst.</string>
