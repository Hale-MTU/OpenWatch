    <string name="settings_watch_notifications_title">שליחת התראות לשעון</string>
    <string name="settings_watch_notifications_body">התראות הטלפון מופיעות על פרק כף היד שלך. הן נקראות במכשיר הזה ונשלחות רק לשעון הזה.</string>
    <string name="settings_watch_notifications_grant">מתן גישה להתראות</string>
    <string name="settings_watch_notifications_grant_body">את הגישה הזו Android מבקש במסך ההגדרות שלו. OpenWatch לא יכול לבקש אותה מכאן.</string>
