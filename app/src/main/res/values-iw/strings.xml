    <string name="settings_watch_music">שליטה במוזיקה בשעון</string>
    <string name="settings_watch_music_body">השעון מציג מה מתנגן בטלפון, ומפרק כף היד אפשר להפעיל, להשהות, לדלג ולשנות את עוצמת הקול. פועל כל עוד השעון נשאר מחובר.</string>
    <string name="settings_watch_music_no_access">הגישה להתראות כבויה. Android מציג את נגני המדיה של הטלפון רק לאפליקציה שיש לה גישה כזו. אפשר להעניק אותה בהגדרות המערכת.</string>
    <string name="settings_watch_music_disclosure_title">\u200FOpenWatch יקרא מה מתנגן בטלפון שלך</string>
    <string name="settings_watch_music_disclosure_body">כדי להציג פקדי מוזיקה בשעון שלך, OpenWatch קורא את נגני המדיה של הטלפון: איזו אפליקציה מנגנת, הרצועה, האומן והאלבום, וכמה מהרצועה כבר התנגן.\n\nמערכת Android מציגה את הנגנים רק לאפליקציה שיש לה גישה להתראות, ולכן המסך הבא מבקש את הגישה הזו. כל עוד העברת ההתראות כבויה, OpenWatch לא שומר את ההתראות שלך ולא מעביר אותן.\n\nפרטי הרצועה נקראים במכשיר הזה ונשלחים רק לשעון שהתאמת, דרך Bluetooth. הם אף פעם לא נשמרים.\n\nאפשר לכבות את האפשרות הזו בכל שלב.</string>
    <string name="settings_watch_calendar">יומן בשעון</string>
    <string name="settings_watch_calendar_body">הצגת האירועים הקרובים מהטלפון בתצוגה המהירה של היומן בשעון. האירועים נשלחים לשעון דרך Bluetooth ולשום מקום אחר.</string>
    <string name="settings_watch_calendar_no_permission">הגישה ליומן נדחתה. אפשר להעניק אותה בהגדרות המערכת כדי לסנכרן אירועים.</string>
    <string name="settings_watch_navigation">הנחיות ניווט של CoMaps בשעון</string>
    <string name="settings_watch_navigation_body">בכל פעם ש-CoMaps מנווט, השעון מציג את הפנייה הבאה, את המרחק אליה ואת הרחוב, בהתראה שמתעדכנת במקום. אין צורך בהקלטה; זה עובד גם במהלך הקלטה.</string>
    <string name="settings_watch_navigation_no_permission">הגישה ל-CoMaps נדחתה, כך שאין מה לשלוח. אפשר להעניק אותה בהגדרות המערכת, או להתקין את CoMaps.</string>
    <string name="settings_watch_agps">נתוני אפמריס של GPS</string>
    <string name="settings_watch_agps_body">ייבוא קובץ חיזוי לוויינים, כדי שהשעון ימצא GPS תוך שניות. שום דבר לא מורד: צריך להשיג את הקובץ בעצמך, ו-OpenWatch מעביר אותו כשהשעון מבקש.</string>
