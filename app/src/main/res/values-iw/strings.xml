    <string name="settings_watch_notifications_only_allowed">רק אפליקציות שאבחר</string>
    <string name="settings_watch_notifications_only_allowed_body">כשהאפשרות מופעלת, רק האפליקציות שהופעלו למטה שולחות. כשהיא כבויה, כל האפליקציות שולחות חוץ מאלה שכובו. כל רשימה נשמרת.</string>
    <string name="settings_watch_notifications_hide_sensitive">הסתרת תוכן רגיש</string>
