    <string name="settings_watch_live_readings">קריאות חיות</string>
    <string name="settings_watch_live_readings_body">הדופק והצעדים משודרים מהשעון כל עוד הוא מחובר, להצגה בלוח הבקרה. השעון צורך יותר סוללה.</string>
    <string name="settings_watch_stay_connected">שמירה על חיבור</string>
    <string name="settings_watch_stay_connected_body">החיבור לשעון נשמר בכל פעם שהוא בטווח. כך השעון יכול לקבל את מזג האוויר, למצוא את הטלפון הזה ולהעביר הקלטות חדשות ברגע שהן מסתיימות — במחיר מסוים בסוללה של השעון והטלפון.</string>
    <string name="settings_watch_high_mtu">מנות Bluetooth גדולות</string>
    <string name="settings_watch_high_mtu_body">בקשה מהשעון למנות Bluetooth גדולות יותר, כדי שהסנכרון יהיה מהיר בהרבה. כדאי לכבות את האפשרות אם השעון מתנתק שוב ושוב או שהסנכרון אף פעם לא מתחיל.</string>
    <string name="unit_bpm">פעימות לדקה</string>
    <string name="dashboard_summary_today">היום</string>
    <string name="privacy_policy_body_2">האפליקציה הזו לא מעלה את נתוני הבריאות שלך לשירות ענן, לא כוללת פרסומות ולא משתפת נתונים עם צדדים שלישיים.</string>
    <string name="privacy_policy_body_3">\u200FOpenWatch אינו מכשיר רפואי, ואינו מאבחן, מטפל, מרפא או מונע מחלה או מצב רפואי כלשהם. הוא אינו תחליף לייעוץ רפואי, לאבחון או לטיפול מאיש מקצוע מוסמך בתחום הבריאות.</string>
