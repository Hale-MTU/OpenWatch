    <string name="settings_watch_notifications_only_allowed">Vain valitsemani sovellukset</string>
    <string name="settings_watch_notifications_only_allowed_body">Kun tämä on päällä, vain alla päälle kytketyt sovellukset lähettävät. Kun se on pois päältä, kaikki sovellukset lähettävät paitsi pois kytketyt. Kumpikin luettelo säilyy.</string>
    <string name="settings_watch_notifications_hide_sensitive">Piilota arkaluontoinen sisältö</string>
