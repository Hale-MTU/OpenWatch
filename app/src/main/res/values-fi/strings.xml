    <string name="settings_watch_agps_imported">Valmis luovutettavaksi.</string>
    <string name="settings_watch_agps_not_ephemeris">Tiedosto ei ole GPS-efemeriditietoa.</string>
    <string name="settings_watch_agps_stale">Tiedosto on liian vanha auttaakseen. Efemeridi ennustaa satelliittien sijainnit, joten yli viikon vanha on huonompi kuin ei mitään.</string>
