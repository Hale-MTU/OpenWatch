opt_out_usage

default_platform(:android)

require "pathname"

OPENWATCH_PACKAGE_NAME = "tech.mmarca.openwatch"
OPENWATCH_METADATA_PATH = "fastlane/metadata/android"
OPENWATCH_PROJECT_ROOT = File.expand_path("..", __dir__)

# The phone app and the watch app share the listing and the applicationId.
# Play keeps the watch on its own form-factor tracks, named "wear:<track>" in
# the Play Developer API; supply and google_play_track_version_codes pass the
# name through. The phone's tracks keep the plain names.
def openwatch_track(form_factor, track)
  form_factor.to_s == "wear" ? "wear:#{track}" : track
end

def openwatch_form_factor(options)
  form_factor = (options[:form_factor] || ENV["OPENWATCH_FORM_FACTOR"] || "phone").to_s
  UI.user_error!("form_factor must be phone or wear, got #{form_factor}") unless %w[phone wear].include?(form_factor)
  form_factor
end

def openwatch_project_path(path)
  value = path.to_s
  return value if value.empty?

  pathname = Pathname.new(value)
  pathname.absolute? ? value : File.expand_path(value, OPENWATCH_PROJECT_ROOT)
end

platform :android do
  desc "Upload a signed Android App Bundle (the phone's, or the watch's with form_factor:wear) to Google Play open testing"
  lane :open_testing do |options|
    json_key = options[:json_key] || ENV["GOOGLE_PLAY_JSON_KEY"]
    aab = options[:aab] || ENV["OPENWATCH_NIGHTLY_AAB"]
    version_code = options[:version_code] || ENV["OPENWATCH_VERSION_CODE"]
    form_factor = openwatch_form_factor(options)
    beta_track = openwatch_track(form_factor, "beta")

    UI.user_error!("json_key is required") if json_key.to_s.empty?
    UI.user_error!("aab is required") if aab.to_s.empty?

    json_key = openwatch_project_path(json_key)
    aab = openwatch_project_path(aab)

    UI.user_error!("aab does not exist: #{aab}") unless File.file?(aab)

    if version_code.to_s.length > 0
      existing_codes = google_play_track_version_codes(
        package_name: OPENWATCH_PACKAGE_NAME,
        json_key: json_key,
        track: beta_track
      ).map(&:to_i)

      if existing_codes.include?(version_code.to_i)
        UI.message("Version code #{version_code} is already on Google Play track '#{beta_track}'; skipping upload.")
        next
      end

      # Play refuses a rollout no existing user can upgrade to. Codes that only
      # ever went to Play carry no release marker, so the versionCode counter
      # cannot see them; fail here with the fix instead of letting supply
      # surface a cryptic Google API error.
      max_existing = existing_codes.max
      if max_existing && max_existing >= version_code.to_i
        UI.user_error!(
          "Google Play track '#{beta_track}' already serves versionCode #{max_existing} >= incoming #{version_code}; " \
          "no existing user could upgrade, so supply would be rejected. " \
          "Bump openwatch.versionCode in gradle.properties past #{max_existing}" \
          "#{form_factor == 'wear' ? ' - 2000000000' : ''}."
        )
      end
    end

    supply(
      package_name: OPENWATCH_PACKAGE_NAME,
      json_key: json_key,
      aab: aab,
      track: beta_track,
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      changes_not_sent_for_review: ENV["OPENWATCH_PLAY_CHANGES_NOT_SENT_FOR_REVIEW"] == "true",
      timeout: 600
    )
  end

  desc "Promote the version from open testing to Google Play production (the phone run carries the store metadata; form_factor:wear promotes the watch), or upload it there when open testing never had it"
  lane :production do |options|
    json_key = options[:json_key] || ENV["GOOGLE_PLAY_JSON_KEY"]
    aab = options[:aab] || ENV["OPENWATCH_RELEASE_AAB"]
    version_code = options[:version_code] || ENV["OPENWATCH_VERSION_CODE"]
    form_factor = openwatch_form_factor(options)
    beta_track = openwatch_track(form_factor, "beta")
    production_track = openwatch_track(form_factor, "production")
    # One listing: the phone run syncs the store text, changelogs and images;
    # the watch run touches its tracks only.
    metadata_options = if form_factor == "wear"
      { skip_upload_metadata: true, skip_upload_changelogs: true, skip_upload_images: true, skip_upload_screenshots: true }
    else
      { metadata_path: OPENWATCH_METADATA_PATH, sync_image_upload: true }
    end

    UI.user_error!("json_key is required") if json_key.to_s.empty?
    UI.user_error!("aab is required") if aab.to_s.empty?

    json_key = openwatch_project_path(json_key)
    aab = openwatch_project_path(aab)

    UI.user_error!("aab does not exist: #{aab}") unless File.file?(aab)

    if version_code.to_s.length > 0
      existing_codes = google_play_track_version_codes(
        package_name: OPENWATCH_PACKAGE_NAME,
        json_key: json_key,
        track: production_track
      ).map(&:to_i)

      if existing_codes.include?(version_code.to_i)
        UI.message("Version code #{version_code} is already on Google Play track '#{production_track}'; skipping production upload.")
        next
      end

      # Same guard as open_testing: surface a downgrade as an actionable
      # failure before supply hits Play's opaque rollout error.
      max_existing = existing_codes.max
      if max_existing && max_existing >= version_code.to_i
        UI.user_error!(
          "Google Play track '#{production_track}' already serves versionCode #{max_existing} >= incoming #{version_code}; " \
          "no existing user could upgrade, so supply would be rejected. " \
          "Bump openwatch.versionCode in gradle.properties past #{max_existing}" \
          "#{form_factor == 'wear' ? ' - 2000000000' : ''}."
        )
      end

      # The pipeline's stage 2 put this version on open testing; production is
      # then a promotion of that same release, with the store metadata, not a
      # second upload. A version open testing never had (Play was paused at the
      # time) falls through to the upload below.
      beta_codes = google_play_track_version_codes(
        package_name: OPENWATCH_PACKAGE_NAME,
        json_key: json_key,
        track: beta_track
      ).map(&:to_i)
      if beta_codes.include?(version_code.to_i)
        UI.message("Promoting version code #{version_code} from '#{beta_track}' to '#{production_track}'.")
        supply(
          package_name: OPENWATCH_PACKAGE_NAME,
          json_key: json_key,
          track: beta_track,
          track_promote_to: production_track,
          track_promote_release_status: "completed",
          version_code: version_code.to_i,
          skip_upload_aab: true,
          skip_upload_apk: true,
          changes_not_sent_for_review: ENV["OPENWATCH_PLAY_CHANGES_NOT_SENT_FOR_REVIEW"] == "true",
          timeout: 600,
          **metadata_options
        )
        next
      end
      UI.message("Version code #{version_code} is not on '#{beta_track}'; uploading the bundle to '#{production_track}'.")
    end

    supply(
      package_name: OPENWATCH_PACKAGE_NAME,
      json_key: json_key,
      aab: aab,
      track: production_track,
      release_status: "completed",
      changes_not_sent_for_review: ENV["OPENWATCH_PLAY_CHANGES_NOT_SENT_FOR_REVIEW"] == "true",
      timeout: 600,
      **metadata_options
    )
  end
end
