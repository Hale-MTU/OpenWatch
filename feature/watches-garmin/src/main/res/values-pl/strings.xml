    <string name="settings_watch_notifications_only_allowed">Tylko wybrane przeze mnie aplikacje</string>
    <string name="settings_watch_notifications_only_allowed_body">Włączone: wysyłają tylko aplikacje włączone poniżej. Wyłączone: wysyłają wszystkie poza wyłączonymi. Obie listy zostają zachowane.</string>
    <string name="settings_watch_notifications_hide_sensitive">Ukrywaj poufne treści</string>
    <string name="settings_watch_notifications_hide_sensitive_body">Gdy ustawienia powiadomień Androida ukrywają poufne treści aplikacji na ekranie blokady, zegarek dostaje tylko tytuł.</string>
    <string name="settings_watch_pair_title">Sparuj ten zegarek</string>
    <string name="settings_watch_pair_body">OpenWatch sparuje się z zegarkiem, a potem skopiuje zarejestrowane pliki aktywności, snu i zdrowia. Potwierdź kod pokazany na zegarku, gdy się pojawi.</string>
    <string name="settings_watch_step_bonding">Parowanie z zegarkiem</string>
    <string name="settings_watch_step_associating">Prośba do Androida o dostęp</string>
    <string name="settings_watch_step_associating_hint">Opcjonalne. Zezwolenie pozwala synchronizacji niezawodnie działać w tle.</string>
    <string name="settings_watch_step_probing">Sprawdzanie, co obsługuje zegarek</string>
    <string name="settings_watch_live_readings_body">Przesyła tętno i kroki z zegarka na pulpit, gdy zegarek jest połączony. Zużywa więcej baterii zegarka.</string>
