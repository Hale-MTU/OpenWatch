    <string name="settings_watch_notifications_section">Powiadomienia</string>
    <string name="settings_watch_notifications_title">Wysyłaj powiadomienia na zegarek</string>
    <string name="settings_watch_notifications_body">Powiadomienia z telefonu pojawiają się na nadgarstku. Odczytywane na tym urządzeniu i wysyłane tylko do tego zegarka.</string>
    <string name="settings_watch_notifications_grant">Zezwól na dostęp do powiadomień</string>
    <string name="settings_watch_notifications_grant_body">Android prosi o to na własnym ekranie ustawień. OpenWatch nie może poprosić o to stąd.</string>
    <string name="settings_watch_notifications_apps_none">Wszystkie aplikacje wysyłają na zegarek</string>
    <plurals name="settings_watch_notifications_apps_blocked">
