    <string name="settings_watch_notifications_apps_intro">Wyłącz aplikację, aby jej powiadomienia nie trafiały na zegarek. Cała reszta nadal dociera.</string>
    <string name="settings_watch_notifications_apps_intro_allowed">Włącz aplikację, aby jej powiadomienia trafiały na zegarek. Nic innego nie dociera.</string>
    <string name="settings_watch_notifications_apps_allowed_none">Żadna aplikacja nie wysyła jeszcze na zegarek</string>
