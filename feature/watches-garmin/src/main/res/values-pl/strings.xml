    <string name="settings_watch_agps_kind_tar">Archiwum konstelacji</string>
    <string name="settings_watch_agps_kind_rx">rxNetworks CPE</string>
    <string name="settings_watch_agps_kind_sony">Sony CPE</string>
    <string name="settings_watch_live_readings">Odczyty na żywo</string>
    <string name="settings_watch_stay_connected">Pozostań połączony</string>
    <string name="settings_watch_stay_connected_body">Utrzymuje połączenie z zegarkiem zawsze, gdy jest w zasięgu. Zegarek może wtedy pobierać pogodę, znajdować ten telefon i przekazywać nowe nagrania zaraz po ich zakończeniu — kosztem baterii zegarka i telefonu.</string>
    <string name="settings_watch_high_mtu">Duże pakiety Bluetooth</string>
    <string name="settings_watch_high_mtu_body">Prosi zegarek o większe pakiety Bluetooth, dzięki czemu synchronizacja jest znacznie szybsza. Wyłącz, jeśli zegarek ciągle traci połączenie lub synchronizacja nigdy nie rusza.</string>
