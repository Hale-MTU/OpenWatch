    <string name="settings_watch_notifications_section">Notifications</string>
    <string name="settings_watch_notifications_title">Send notifications to the watch</string>
    <string name="settings_watch_notifications_body">Phone notifications appear on your wrist. Read on this device and sent only to this watch.</string>
    <string name="settings_watch_notifications_grant">Allow notification access</string>
    <string name="settings_watch_notifications_grant_body">Android asks for this on its own settings screen. OpenWatch cannot request it from here.</string>
    <string name="settings_watch_notifications_apps_none">All apps send to the watch</string>
    <plurals name="settings_watch_notifications_apps_blocked">
        <item quantity="one">%1$d app silenced</item>
        <item quantity="other">%1$d apps silenced</item>
    </plurals>
    <string name="settings_watch_notifications_apps_intro">Turn an app off to stop its notifications reaching the watch. Everything else keeps coming through.</string>
    <string name="settings_watch_notifications_apps_intro_allowed">Turn an app on to send its notifications to the watch. Nothing else comes through.</string>
    <string name="settings_watch_notifications_apps_allowed_none">No app sends to the watch yet</string>
    <plurals name="settings_watch_notifications_apps_allowed">
        <item quantity="one">%1$d app sends to the watch</item>
        <item quantity="other">%1$d apps send to the watch</item>
    </plurals>
    <string name="settings_watch_notifications_only_allowed">Only apps I choose</string>
    <string name="settings_watch_notifications_only_allowed_body">On, only the apps switched on below send. Off, every app sends but the ones switched off. Each list is kept.</string>
    <string name="settings_watch_notifications_hide_sensitive">Hide sensitive content</string>
    <string name="settings_watch_notifications_hide_sensitive_body">Where Android\'s notification settings hide an app\'s sensitive content on the lock screen, the watch gets the title only.</string>
    <string name="settings_watch_pair_title">Pair this watch</string>
    <string name="settings_watch_pair_body">OpenWatch will pair with the watch, then copy its recorded activity, sleep and health files. Confirm the code shown on the watch when it appears.</string>
