    <string name="settings_watch_live_readings">Live readings</string>
    <string name="settings_watch_live_readings_body">Streams heart rate and steps from the watch while it is connected, for the dashboard. Uses more watch battery.</string>
    <string name="settings_watch_stay_connected">Stay connected</string>
    <string name="settings_watch_stay_connected_body">Keeps a link to the watch whenever it is in range. The watch can then fetch weather, find this phone, and hand over new recordings the moment they finish — at some cost to watch and phone battery.</string>
    <string name="settings_watch_high_mtu">Large Bluetooth packets</string>
    <string name="settings_watch_high_mtu_body">Asks the watch for larger Bluetooth packets, which makes a sync much faster. Turn it off if the watch keeps dropping the link or a sync never gets going.</string>
